# Copy to .dev.vars (it is not committed to git) and paste your Groq key.
GROQ_API_KEY=gsk_...
# Optional: more daily limits with the same models. Gemini's key is free, with no billing (aistudio.google.com/apikey);
# Cerebras's trial is $5 of credit for 30 days (up to 1M tokens a day) once a payment method is added, then it stops
# and nothing is charged by itself (cloud.cerebras.ai)
# CEREBRAS_API_KEY=...
# GEMINI_API_KEY=...
# Optional: a paid fallback, asked only when every free model is at its limit, at most PAID_DAILY_TOKENS a day
# DEEPINFRA_API_KEY=...
# Optional: a separate salt for hashing IP addresses in the limit counters
# IP_SALT=any-long-random-string
# Optional: a Pixabay API key (free at pixabay.com/api/docs) adds Pixabay to the picture search
# PIXABAY_KEY=...
# Optional: a long random string; with it in the X-Admin-Token header the site's owner takes down any deck
# ADMIN_TOKEN=...
