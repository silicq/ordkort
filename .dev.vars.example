# Copy to .dev.vars (it is not committed to git) and paste your Groq key.
GROQ_API_KEY=gsk_...
# Optional: a separate salt for hashing IP addresses in the limit counters
# IP_SALT=any-long-random-string
# Optional: a Pixabay API key (free at pixabay.com/api/docs) adds Pixabay to the picture search
# PIXABAY_KEY=...
# Optional: a Google Cloud Text-to-Speech API key gives cards without a recording a synthetic voice
# GOOGLE_TTS_KEY=...
# Optional: a long random string; with it in the X-Admin-Token header the site's owner takes down any deck
# ADMIN_TOKEN=...
