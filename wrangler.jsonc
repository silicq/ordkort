{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ordkort",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  // The site in public/ is served as free, unlimited static assets; the Worker runs only for /api/*
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // The database is created automatically on the first deploy (wrangler ≥ 4.45), the schema on the first request
  "d1_databases": [
    { "binding": "DB", "database_name": "ordkort" }
  ],

  // Once a day: delete expired limit counters, link codes and abandoned sync copies
  "triggers": { "crons": ["17 3 * * *"] },

  // Request logs are off: the site keeps nothing unnecessary about its visitors
  "observability": { "enabled": false },

  // AI limits (can be changed in the Cloudflare dashboard without touching the code).
  // The GROQ_API_KEY secret is set separately: npx wrangler secret put GROQ_API_KEY
  "vars": {
    "AI_PER_HOUR": "40",
    "AI_PER_DAY": "120",
    "AI_DAILY_BUDGET": "2500"
  }
}
