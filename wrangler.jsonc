{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ordkort",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  // Before every deploy (and `wrangler dev`): write the site's version to public/js/build.js
  "build": { "command": "node scripts/build.mjs" },

  // The site in public/ is served as free, unlimited static assets; the Worker runs only for /api/*
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/s/*", "/look/*", "/.well-known/ai-catalog.json", "/.well-known/mcp-registry-auth"]
  },

  // The database is created automatically on the first deploy (wrangler ≥ 4.45), the schema on the first request
  "d1_databases": [
    { "binding": "DB", "database_name": "ordkort" }
  ],

  // Once a day: delete expired limit counters, link codes and abandoned sync copies.
  // Every 15 minutes: fill one more group of the shared word bank while the site is quiet (src/warm.js)
  "triggers": { "crons": ["17 3 * * *", "*/15 * * * *"] },

  // Request logs are off: the site keeps nothing unnecessary about its visitors
  "observability": { "enabled": false },

  // AI limits (can be changed in the Cloudflare dashboard without touching the code).
  // The GROQ_API_KEY secret is set separately: npx wrangler secret put GROQ_API_KEY
  // Optional: npx wrangler secret put PIXABAY_KEY adds Pixabay to the picture search (src/images.js)
  // Optional: npx wrangler secret put GOOGLE_TTS_KEY gives cards without a recording a synthetic voice (src/voice.js)
  // Optional: npx wrangler secret put ADMIN_TOKEN lets the site's owner take down decks (src/library.js)
  "vars": {
    "AI_PER_HOUR": "40",
    "AI_PER_DAY": "120",
    "AI_DAILY_BUDGET": "2500",
    // How many lists of words the cron may generate a day for the bank of ready decks (src/warm.js).
    // Groq's free plan gives each model 200,000 tokens a day, about 100–150 answers for the whole site: keep this small
    "WARM_PER_DAY": "24",
    // Room in the database a day (src/limits.js takeStore): sync copies and their files, links, library decks,
    // voices. Per person, and for the whole site. D1 holds 500 MB on the free plan, 10 GB on the paid one:
    // on the free plan lower STORE_SITE_DAY_MB, or the database can still fill in a few days of an attack
    "STORE_PER_DAY_MB": "100",
    "STORE_SITE_DAY_MB": "1000",
    // Requests to the moderating models when decks are published to the library (src/library.js)
    "GUARD_PER_DAY": "60",
    "GUARD_SITE_DAY": "400",
    // characters a day the synthetic voice may speak for the whole site (src/voice.js), when GOOGLE_TTS_KEY is set
    "TTS_DAILY_CHARS": "30000"
  },

  // Branch previews (npx wrangler preview) inherit nothing from the settings above.
  // Their own empty database, so test branches never touch real users' data; cron stays production-only.
  // The secret is set separately: npx wrangler preview secret put GROQ_API_KEY
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "ordkort-preview", "database_id": "38df7284-c34c-4985-8605-df7b51c622c1" }
    ],
    "vars": {
      "AI_PER_HOUR": "40",
      "AI_PER_DAY": "120",
      "AI_DAILY_BUDGET": "2500"
    },
    "observability": { "enabled": false }
  }
}
