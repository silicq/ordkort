{"words":[{"term":"hei","tr":"cześć","pos":"interjection","forms":"","ex":"Hei, hvordan går det?","ex_tr":"Cześć, co słychać?","chk":1},{"term":"god morgen","tr":"dzień dobry (rano)","pos":"phrase","forms":"","ex":"God morgen! Har du sovet godt?","ex_tr":"Dzień dobry! Dobrze spałeś?"},{"term":"god dag","tr":"dzień dobry","pos":"phrase","forms":"","ex":"God dag, jeg har time klokka ti.","ex_tr":"Dzień dobry, jestem umówiony na dziesiątą."},{"term":"god kveld","tr":"dobry wieczór","pos":"phrase","forms":"","ex":"God kveld og velkommen!","ex_tr":"Dobry wieczór i witamy!"},{"term":"god natt","tr":"dobranoc","pos":"phrase","forms":"","ex":"God natt, sov godt!","ex_tr":"Dobranoc, śpij dobrze!"},{"term":"ha det","tr":"cześć, na razie","pos":"phrase","forms":"","ex":"Ha det, vi ses i morgen!","ex_tr":"Na razie, do zobaczenia jutro!"},{"term":"takk","tr":"dziękuję, dzięki","pos":"noun","forms":"takka, takker, takkene","ex":"Tusen takk for hjelpen!","ex_tr":"Bardzo dziękuję za pomoc!","chk":1},{"term":"vær så snill","tr":"proszę","pos":"phrase","forms":"","ex":"Kan du lukke døra, vær så snill?","ex_tr":"Możesz zamknąć drzwi, proszę?"},{"term":"unnskyld","tr":"przepraszam","pos":"interjection","forms":"","ex":"Unnskyld, hvor er toalettet?","ex_tr":"Przepraszam, gdzie jest toaleta?","chk":1},{"term":"beklager","tr":"przykro mi, przepraszam","pos":"phrase","forms":"","ex":"Beklager, jeg kom for sent.","ex_tr":"Przepraszam, spóźniłem się."},{"term":"velkommen","tr":"witamy, witaj","pos":"adjective","forms":"velkomment, velkomne","ex":"Velkommen til Norge!","ex_tr":"Witamy w Norwegii!","chk":1},{"term":"hyggelig","tr":"miły, przyjemny","pos":"adjective","forms":"hyggelig, hyggelige, hyggeligere, hyggeligst","ex":"Hyggelig å hilse på deg!","ex_tr":"Miło cię poznać!","chk":1},{"term":"å hilse","tr":"witać się, pozdrawiać","pos":"verb","forms":"hilser, hilste, har hilst","ex":"Hils på bestemor!","ex_tr":"Pozdrów babcię!","chk":1},{"term":"en hilsen","tr":"pozdrowienie","pos":"noun","forms":"hilsenen, hilsener, hilsenene","ex":"Med vennlig hilsen, Anna.","ex_tr":"Z poważaniem, Anna.","chk":1},{"term":"å hete","tr":"nazywać się","pos":"verb","forms":"heter, heta, har heta","ex":"Jeg heter Oleksandr.","ex_tr":"Nazywam się Oleksandr.","chk":1},{"term":"å presentere","tr":"przedstawiać","pos":"verb","forms":"presenterer, presenterte, har presentert","ex":"Kan jeg presentere kona mi?","ex_tr":"Czy mogę przedstawić moją żonę?","chk":1},{"term":"høflig","tr":"uprzejmy, grzeczny","pos":"adjective","forms":"høflig, høflige, høfligere, høfligst","ex":"Det er høflig å si takk.","ex_tr":"Grzecznie jest powiedzieć dziękuję.","chk":1},{"term":"bare hyggelig","tr":"nie ma za co","pos":"phrase","forms":"","ex":"Takk! – Bare hyggelig!","ex_tr":"Dziękuję! – Nie ma za co!"},{"term":"vi ses","tr":"do zobaczenia","pos":"phrase","forms":"","ex":"Vi ses på mandag!","ex_tr":"Do zobaczenia w poniedziałek!"},{"term":"takk for sist","tr":"dzięki za ostatnie spotkanie","pos":"phrase","forms":"","ex":"Hei, takk for sist! Det var en fin kveld.","ex_tr":"Cześć, dzięki za ostatnio! To był miły wieczór."},{"term":"et håndtrykk","tr":"uścisk dłoni","pos":"noun","forms":"håndtrykket, håndtrykk, håndtrykkene","ex":"Han hilste med et fast håndtrykk.","ex_tr":"Przywitał się mocnym uściskiem dłoni.","chk":1}]}
