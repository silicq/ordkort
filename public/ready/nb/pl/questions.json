{"words":[{"term":"hva","tr":"co","pos":"pronoun","forms":"","ex":"Hva er det?","ex_tr":"Co to jest?","chk":1},{"term":"hvem","tr":"kto","pos":"pronoun","forms":"","ex":"Hvem er hun?","ex_tr":"Kim ona jest?","chk":1},{"term":"hvor","tr":"gdzie","pos":"adverb","forms":"","ex":"Hvor er stasjonen?","ex_tr":"Gdzie jest dworzec?","chk":1},{"term":"når","tr":"kiedy","pos":"conjunction","forms":"","ex":"Når åpner butikken?","ex_tr":"Kiedy otwierają sklep?","chk":1},{"term":"hvorfor","tr":"dlaczego","pos":"adverb","forms":"","ex":"Hvorfor er du trist?","ex_tr":"Dlaczego jesteś smutny?","chk":1},{"term":"hvordan","tr":"jak","pos":"adverb","forms":"","ex":"Hvordan har du det?","ex_tr":"Jak się masz?","chk":1},{"term":"hvilken","tr":"który","pos":"determiner","forms":"","ex":"Hvilken buss tar du?","ex_tr":"Którym autobusem jeździsz?","chk":1},{"term":"hvor mye","tr":"ile","pos":"phrase","forms":"","ex":"Hvor mye koster det?","ex_tr":"Ile to kosztuje?"},{"term":"hvor mange","tr":"ile (policzalne)","pos":"phrase","forms":"","ex":"Hvor mange barn har du?","ex_tr":"Ile masz dzieci?"},{"term":"hva slags","tr":"jaki, jakiego rodzaju","pos":"phrase","forms":"","ex":"Hva slags jobb har du?","ex_tr":"Jaką masz pracę?"},{"term":"og","tr":"i","pos":"conjunction","forms":"","ex":"Hun spiser og drikker.","ex_tr":"Ona je i pije.","chk":1},{"term":"men","tr":"ale","pos":"conjunction","forms":"","ex":"Det er dyrt, men godt.","ex_tr":"Jest drogo, ale smacznie.","chk":1},{"term":"eller","tr":"albo, czy","pos":"conjunction","forms":"","ex":"Te eller kaffe?","ex_tr":"Herbata czy kawa?","chk":1},{"term":"fordi","tr":"ponieważ, bo","pos":"conjunction","forms":"","ex":"Jeg er hjemme fordi jeg er syk.","ex_tr":"Jestem w domu, bo jestem chory.","chk":1},{"term":"hvis","tr":"jeśli, jeżeli","pos":"conjunction","forms":"","ex":"Ring meg hvis du kommer.","ex_tr":"Zadzwoń do mnie, jeśli przyjdziesz.","chk":1},{"term":"at","tr":"że","pos":"conjunction","forms":"","ex":"Jeg vet at du har rett.","ex_tr":"Wiem