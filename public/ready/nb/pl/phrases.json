{"words":[{"term":"det går bra","tr":"w porządku, dobrze","pos":"phrase","forms":"","ex":"Hvordan går det? – Det går bra!","ex_tr":"Jak się masz? – Dobrze!"},{"term":"ingen fare","tr":"nic nie szkodzi, spokojnie","pos":"phrase","forms":"","ex":"Beklager! – Ingen fare.","ex_tr":"Przepraszam! – Nic nie szkodzi."},{"term":"ta det med ro","tr":"spokojnie, nie spiesz się","pos":"phrase","forms":"","ex":"Ta det med ro, vi rekker det.","ex_tr":"Spokojnie, zdążymy."},{"term":"det spiller ingen rolle","tr":"to nie ma znaczenia","pos":"phrase","forms":"","ex":"Kaffe eller te? – Det spiller ingen rolle.","ex_tr":"Kawa czy herbata? – Wszystko jedno."},{"term":"det kommer an på","tr":"to zależy","pos":"phrase","forms":"","ex":"Kommer du? – Det kommer an på været.","ex_tr":"Przyjdziesz? – To zależy od pogody."},{"term":"så klart","tr":"oczywiście","pos":"phrase","forms":"","ex":"Kan du hjelpe meg? – Så klart!","ex_tr":"Pomożesz mi? – Oczywiście!"},{"term":"kos deg","tr":"baw się dobrze","pos":"phrase","forms":"","ex":"Kos deg på ferien!","ex_tr":"Udanych wakacji!"},{"term":"lykke til","tr":"powodzenia","pos":"phrase","forms":"","ex":"Lykke til på prøven!","ex_tr":"Powodzenia na sprawdzianie!"},{"term":"god bedring","tr":"wracaj do zdrowia","pos":"phrase","forms":"","ex":"God bedring, håper du blir frisk snart!","ex_tr":"Wracaj do zdrowia, mam nadzieję, że szybko wyzdrowiejesz!"},{"term":"gratulerer med dagen","tr":"wszystkiego najlepszego (z okazji urodzin)","pos":"phrase","forms":"","ex":"Gratulerer med dagen, Kari!","ex_tr":"Wszystkiego najlepszego, Kari!"},{"term":"det er synd","tr":"szkoda","pos":"phrase","forms":"","ex":"Det er synd at du ikke kan komme.","ex_tr":"Szkoda, że nie możesz przyjść."},{"term":"i orden","tr":"w porządku, OK","pos":"phrase","forms":"","ex":"Alt er i orden.","ex_tr":"Wszystko jest w porządku."},{"term":"helt greit","tr":"całkiem w porządku, pasuje","pos":"phrase","forms":"","ex":"Kan vi møtes i morgen? – Helt greit.","ex_tr":"Możemy się spotkać jutro? – Pasuje."},{"term":"det ordner seg","tr":"jakoś to będzie","pos":"phrase","forms":"","ex":"Ikke vær redd, det ordner seg.","ex_tr":"Nie bój się, jakoś to będzie."},{"term":"hva er i veien?","tr":"co się stało?","pos":"phrase","forms":"","ex":"Du ser trist ut. Hva er i veien?","ex_tr":"Wyglądasz na smutnego. Co się stało?"},{"term":"jeg er enig","tr":"zgadzam się","pos":"phrase","forms":"","ex":"Jeg er helt enig med deg.","ex_tr":"Całkowicie się z tobą zgadzam."},{"term":"på tide","tr":"najwyższy czas","pos":"phrase","forms":"","ex":"Det er på tide å gå hjem.","ex_tr":"Najwyższy czas iść do domu."},{"term":"etter hvert","tr":"z czasem, stopniowo","pos":"phrase","forms":"","ex":"Du lærer det etter hvert.","ex_tr":"Z czasem się tego nauczysz."},{"term":"skål","tr":"na zdrowie (toast)","pos":"interjection","forms":"","ex":"Skål for brudeparet!","ex_tr":"Zdrowie państwa młodych!","chk":1},{"term":"velbekomme","tr":"smacznego (odpowiedź na podziękowanie za posiłek)","pos":"phrase","forms":"","ex":"Takk for maten! – Velbekomme!","ex_tr":"Dziękuję za posiłek! – Proszę bardzo!"},{"term":"det var en gang","tr":"dawno, dawno temu","pos":"phrase","forms":"","ex":"Det var en gang en konge.","ex_tr":"Dawno, dawno temu był sobie król."},{"term":"bedre sent enn aldri","tr":"lepiej późno niż wcale","pos":"phrase","forms":"","ex":"Du kom! Bedre sent enn aldri.","ex_tr":"Przyszedłeś! Lepiej późno niż wcale."}]}
