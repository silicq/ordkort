{"words":[{"term":"hei","tr":"привіт","pos":"interjection","forms":"","ex":"Hei, hvordan går det?","ex_tr":"Привіт, як справи?","chk":1},{"term":"god morgen","tr":"доброго ранку","pos":"phrase","forms":"","ex":"God morgen! Har du sovet godt?","ex_tr":"Доброго ранку! Добре спав?"},{"term":"god dag","tr":"добрий день","pos":"phrase","forms":"","ex":"God dag, jeg har time klokka ti.","ex_tr":"Добрий день, я записаний на десяту."},{"term":"god kveld","tr":"добрий вечір","pos":"phrase","forms":"","ex":"God kveld og velkommen!","ex_tr":"Добрий вечір і ласкаво просимо!"},{"term":"god natt","tr":"на добраніч","pos":"phrase","forms":"","ex":"God natt, sov godt!","ex_tr":"На добраніч, спи солодко!"},{"term":"ha det","tr":"бувай","pos":"phrase","forms":"","ex":"Ha det, vi ses i morgen!","ex_tr":"Бувай, до завтра!"},{"term":"takk","tr":"дякую","pos":"noun","forms":"takka, takker, takkene","ex":"Tusen takk for hjelpen!","ex_tr":"Щиро дякую за допомогу!","chk":1},{"term":"vær så snill","tr":"будь ласка","pos":"phrase","forms":"","ex":"Kan du lukke døra, vær så snill?","ex_tr":"Зачини, будь ласка, двері."},{"term":"unnskyld","tr":"перепрошую","pos":"interjection","forms":"","ex":"Unnskyld, hvor er toalettet?","ex_tr":"Перепрошую, де туалет?","chk":1},{"term":"beklager","tr":"вибачте, на жаль","pos":"phrase","forms":"","ex":"Beklager, jeg kom for sent.","ex_tr":"Вибачте, я запізнився."},{"term":"velkommen","tr":"ласкаво просимо","pos":"adjective","forms":"velkomment, velkomne","ex":"Velkommen til Norge!","ex_tr":"Ласкаво просимо до Норвегії!","chk":1},{"term":"hyggelig","tr":"приємний","pos":"adjective","forms":"hyggelig, hyggelige, hyggeligere, hyggeligst","ex":"Hyggelig å hilse på deg!","ex_tr":"Приємно познайомитися!","chk":1},{"term":"å hilse","tr":"вітатися","pos":"verb","forms":"hilser, hilste, har hilst","ex":"Hils på bestemor!","ex_tr":"Привітайся з бабусею!","chk":1},{"term":"en hilsen","tr":"привіт, вітання","pos":"noun","forms":"hilsenen, hilsener, hilsenene","ex":"Med vennlig hilsen, Anna.","ex_tr":"З повагою, Анна.","chk":1},{"term":"å hete","tr":"зватися","pos":"verb","forms":"heter, heta, har heta","ex":"Jeg heter Oleksandr.","ex_tr":"Мене звати Олександр.","chk":1},{"term":"å presentere","tr":"представляти","pos":"verb","forms":"presenterer, presenterte, har presentert","ex":"Kan jeg presentere kona mi?","ex_tr":"Дозвольте представити мою дружину.","chk":1},{"term":"høflig","tr":"ввічливий","pos":"adjective","forms":"høflig, høflige, høfligere, høfligst","ex":"Det er høflig å si takk.","ex_tr":"Казати «дякую» ввічливо.","chk":1},{"term":"bare hyggelig","tr":"нема за що","pos":"phrase","forms":"","ex":"Takk! – Bare hyggelig!","ex_tr":"Дякую! — Нема за що!"},{"term":"vi ses","tr":"побачимося","pos":"phrase","forms":"","ex":"Vi ses på mandag!","ex_tr":"Побачимося в понеділок!"},{"term":"takk for sist","tr":"дякую за минулу зустріч","pos":"phrase","forms":"","ex":"Hei, takk for sist! Det var en fin kveld.","ex_tr":"Привіт, дякую за минулий раз! Гарний був вечір."},{"term":"et håndtrykk","tr":"рукостискання","pos":"noun","forms":"håndtrykket, håndtrykk, håndtrykkene","ex":"Han hilste med et fast håndtrykk.","ex_tr":"Він привітався міцним рукостисканням.","chk":1},{"term":"hallo","tr":"привіт","pos":"interjection","forms":"","ex":"Hallo! Jeg heter Anna.","ex_tr":"Привіт! Мене звати Анна."},{"term":"jeg","tr":"я","pos":"pronoun","forms":"","ex":"Jeg heter Ole.","ex_tr":"Мене звати Оле.","chk":1},{"term":"du","tr":"ти","pos":"pronoun","forms":"","ex":"Hvordan har du det?","ex_tr":"Як у тебе справи?","chk":1},{"term":"han","tr":"він","pos":"pronoun","forms":"","ex":"Han er lærer.","ex_tr":"Він вчитель.","chk":1},{"term":"hun","tr":"вона","pos":"pronoun","forms":"","ex":"Hun er student.","ex_tr":"Вона студентка.","chk":1},{"term":"et navn","tr":"ім'я","pos":"noun","forms":"navnet, navn, navnene","ex":"Hva er ditt navn?","ex_tr":"Як твоє ім'я?","chk":1},{"term":"en dag","tr":"день","pos":"noun","forms":"dagen, dager, dagene","ex":"God dag!","ex_tr":"Доброго дня!","chk":1},{"term":"en morgen","tr":"ранок","pos":"noun","forms":"morgenen, morgener, morgenene","ex":"God morgen!","ex_tr":"Доброго ранку!","chk":1},{"term":"å si","tr":"казати","pos":"verb","forms":"sier, sa, har sagt","ex":"Jeg sier hei.","ex_tr":"Я кажу привіт.","chk":1},{"term":"å være","tr":"бути","pos":"verb","forms":"er, var, har vært","ex":"Jeg er student.","ex_tr":"Я студент.","chk":1},{"term":"god","tr":"добрий","pos":"adjective","forms":"godt, gode, bedre, best","ex":"Dette er en god bok.","ex_tr":"Це хороша книга.","chk":1},{"term":"vær så god","tr":"будь ласка (вручити)","pos":"phrase","forms":"","ex":"Her er boken, vær så god.","ex_tr":"Ось книга, будь ласка."}]}
