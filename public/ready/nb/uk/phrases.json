{"words":[{"term":"det går bra","tr":"усе добре","pos":"phrase","forms":"","ex":"Hvordan går det? – Det går bra!","ex_tr":"Як справи? — Усе добре!"},{"term":"ingen fare","tr":"нічого страшного","pos":"phrase","forms":"","ex":"Beklager! – Ingen fare.","ex_tr":"Вибач! — Нічого страшного."},{"term":"ta det med ro","tr":"не хвилюйся","pos":"phrase","forms":"","ex":"Ta det med ro, vi rekker det.","ex_tr":"Спокійно, ми встигнемо."},{"term":"det spiller ingen rolle","tr":"це неважливо","pos":"phrase","forms":"","ex":"Kaffe eller te? – Det spiller ingen rolle.","ex_tr":"Кава чи чай? — Неважливо."},{"term":"det kommer an på","tr":"залежить","pos":"phrase","forms":"","ex":"Kommer du? – Det kommer an på været.","ex_tr":"Прийдеш? — Залежить від погоди."},{"term":"så klart","tr":"звісно","pos":"phrase","forms":"","ex":"Kan du hjelpe meg? – Så klart!","ex_tr":"Допоможеш? — Звісно!"},{"term":"kos deg","tr":"насолоджуйся","pos":"phrase","forms":"","ex":"Kos deg på ferien!","ex_tr":"Гарного відпочинку!"},{"term":"lykke til","tr":"успіху","pos":"phrase","forms":"","ex":"Lykke til på prøven!","ex_tr":"Успіху на іспиті!"},{"term":"god bedring","tr":"одужуй","pos":"phrase","forms":"","ex":"God bedring, håper du blir frisk snart!","ex_tr":"Одужуй швидше!"},{"term":"gratulerer med dagen","tr":"з днем народження","pos":"phrase","forms":"","ex":"Gratulerer med dagen, Kari!","ex_tr":"З днем народження, Карі!"},{"term":"det er synd","tr":"шкода","pos":"phrase","forms":"","ex":"Det er synd at du ikke kan komme.","ex_tr":"Шкода, що ти не зможеш прийти."},{"term":"i orden","tr":"гаразд","pos":"phrase","forms":"","ex":"Alt er i orden.","ex_tr":"Усе гаразд."},{"term":"helt greit","tr":"цілком нормально","pos":"phrase","forms":"","ex":"Kan vi møtes i morgen? – Helt greit.","ex_tr":"Зустрінемося завтра? — Без проблем."},{"term":"det ordner seg","tr":"усе владнається","pos":"phrase","forms":"","ex":"Ikke vær redd, det ordner seg.","ex_tr":"Не бійся, усе владнається."},{"term":"hva er i veien?","tr":"що сталося?","pos":"phrase","forms":"","ex":"Du ser trist ut. Hva er i veien?","ex_tr":"Ти сумний. Що сталося?"},{"term":"jeg er enig","tr":"я згоден","pos":"phrase","forms":"","ex":"Jeg er helt enig med deg.","ex_tr":"Я цілком з тобою згоден."},{"term":"på tide","tr":"час","pos":"phrase","forms":"","ex":"Det er på tide å gå hjem.","ex_tr":"Час іти додому."},{"term":"etter hvert","tr":"поступово","pos":"phrase","forms":"","ex":"Du lærer det etter hvert.","ex_tr":"Згодом навчишся."},{"term":"skål","tr":"будьмо","pos":"interjection","forms":"","ex":"Skål for brudeparet!","ex_tr":"За молодих!","chk":1},{"term":"velbekomme","tr":"на здоров’я","pos":"phrase","forms":"","ex":"Takk for maten! – Velbekomme!","ex_tr":"Дякую за їжу! — На здоров’я!"},{"term":"det var en gang","tr":"жив-був","pos":"phrase","forms":"","ex":"Det var en gang en konge.","ex_tr":"Жив-був король."},{"term":"bedre sent enn aldri","tr":"краще пізно, ніж ніколи","pos":"phrase","forms":"","ex":"Du kom! Bedre sent enn aldri.","ex_tr":"Ти прийшов! Краще пізно, ніж ніколи."}]}
