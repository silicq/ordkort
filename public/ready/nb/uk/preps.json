а?","chk":1},{"term":"ute","tr":"надворі","pos":"adverb","forms":"","ex":"Barna leker ute.","ex_tr":"Діти граються надворі.","chk":1},{"term":"inne","tr":"всередині","pos":"adverb","forms":"","ex":"Vi er inne når det regner.","ex_tr":"Коли йде дощ, ми вдома.","chk":1},{"term":"der","tr":"там","pos":"adverb","forms":"","ex":"Bor du der?","ex_tr":"Ти там живеш?","chk":1},{"term":"alltid","tr":"завжди","pos":"adverb","forms":"","ex":"Hun er alltid blid.","ex_tr":"Вона завжди весела.","chk":1},{"term":"snart","tr":"скоро","pos":"adverb","forms":"","ex":"Vi er snart framme.","ex_tr":"Ми скоро приїдемо.","chk":1},{"term":"allerede","tr":"вже","pos":"adverb","forms":"","ex":"Toget har allerede gått.","ex_tr":"Потяг уже пішов.","chk":1}]}
