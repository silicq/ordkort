{"words":[{"term":"hei","tr":"привет","pos":"interjection","forms":"","ex":"Hei, hvordan går det?","ex_tr":"Привет, как дела?","chk":1},{"term":"god morgen","tr":"доброе утро","pos":"phrase","forms":"","ex":"God morgen! Har du sovet godt?","ex_tr":"Доброе утро! Хорошо спал?"},{"term":"god dag","tr":"добрый день","pos":"phrase","forms":"","ex":"God dag, jeg har time klokka ti.","ex_tr":"Добрый день, я записан на десять."},{"term":"god kveld","tr":"добрый вечер","pos":"phrase","forms":"","ex":"God kveld og velkommen!","ex_tr":"Добрый вечер и добро пожаловать!"},{"term":"god natt","tr":"спокойной ночи","pos":"phrase","forms":"","ex":"God natt, sov godt!","ex_tr":"Спокойной ночи, спи сладко!"},{"term":"ha det","tr":"пока","pos":"phrase","forms":"","ex":"Ha det, vi ses i morgen!","ex_tr":"Пока, до завтра!"},{"term":"takk","tr":"спасибо","pos":"noun","forms":"takka, takker, takkene","ex":"Tusen takk for hjelpen!","ex_tr":"Большое спасибо за помощь!","chk":1},{"term":"vær så snill","tr":"пожалуйста","pos":"phrase","forms":"","ex":"Kan du lukke døra, vær så snill?","ex_tr":"Закрой, пожалуйста, дверь."},{"term":"unnskyld","tr":"извините","pos":"interjection","forms":"","ex":"Unnskyld, hvor er toalettet?","ex_tr":"Извините, где туалет?","chk":1},{"term":"beklager","tr":"сожалею, простите","pos":"phrase","forms":"","ex":"Beklager, jeg kom for sent.","ex_tr":"Простите, я опоздал."},{"term":"velkommen","tr":"добро пожаловать","pos":"adjective","forms":"velkomment, velkomne","ex":"Velkommen til Norge!","ex_tr":"Добро пожаловать в Норвегию!","chk":1},{"term":"hyggelig","tr":"приятный","pos":"adjective","forms":"hyggelig, hyggelige, hyggeligere, hyggeligst","ex":"Hyggelig å hilse på deg!","ex_tr":"Приятно познакомиться!","chk":1},{"term":"å hilse","tr":"здороваться","pos":"verb","forms":"hilser, hilste, har hilst","ex":"Hils på bestemor!","ex_tr":"Поздоровайся с бабушкой!","chk":1},{"term":"en hilsen","tr":"привет, приветствие","pos":"noun","forms":"hilsenen, hilsener, hilsenene","ex":"Med vennlig hilsen, Anna.","ex_tr":"С уважением, Анна.","chk":1},{"term":"å hete","tr":"называться, зваться","pos":"verb","forms":"heter, heta, har heta","ex":"Jeg heter Oleksandr.","ex_tr":"Меня зовут Александр.","chk":1},{"term":"å presentere","tr":"представлять","pos":"verb","forms":"presenterer, presenterte, har presentert","ex":"Kan jeg presentere kona mi?","ex_tr":"Позвольте представить мою жену.","chk":1},{"term":"høflig","tr":"вежливый","pos":"adjective","forms":"høflig, høflige, høfligere, høfligst","ex":"Det er høflig å si takk.","ex_tr":"Говорить «спасибо» вежливо.","chk":1},{"term":"bare hyggelig","tr":"не за что","pos":"phrase","forms":"","ex":"Takk! – Bare hyggelig!","ex_tr":"Спасибо! — Не за что!"},{"term":"vi ses","tr":"увидимся","pos":"phrase","forms":"","ex":"Vi ses på mandag!","ex_tr":"Увидимся в понедельник!"},{"term":"takk for sist","tr":"спасибо за прошлую встречу","pos":"phrase","forms":"","ex":"Hei, takk for sist! Det var en fin kveld.","ex_tr":"Привет, спасибо за прошлый раз! Хороший был вечер."},{"term":"et håndtrykk","tr":"рукопожатие","pos":"noun","forms":"håndtrykket, håndtrykk, håndtrykkene","ex":"Han hilste med et fast håndtrykk.","ex_tr":"Он поздоровался крепким рукопожатием.","chk":1},{"term":"hallo","tr":"алло, привет","pos":"interjection","forms":"","ex":"Hallo! Kan du høre meg?","ex_tr":"Алло! Ты меня слышишь?"},{"term":"farvel","tr":"прощай, до свидания","pos":"interjection","forms":"","ex":"Farvel, ha en fin dag.","ex_tr":"Прощай, хорошего дня."},{"term":"jeg","tr":"я","pos":"pronoun","forms":"","ex":"Jeg heter Anna.","ex_tr":"Меня зовут Анна.","chk":1},{"term":"du","tr":"ты, вы","pos":"pronoun","forms":"","ex":"Hvordan har du det?","ex_tr":"Как ты?","chk":1},{"term":"han","tr":"он","pos":"pronoun","forms":"","ex":"Han er her.","ex_tr":"Он здесь.","chk":1},{"term":"hun","tr":"она","pos":"pronoun","forms":"","ex":"Hun er snill.","ex_tr":"Она добра.","chk":1},{"term":"en venn","tr":"друг, подруга","pos":"noun","forms":"vennen, venner, vennene","ex":"Dette er min venn.","ex_tr":"Это мой друг.","chk":1},{"term":"en person","tr":"человек, персона","pos":"noun","forms":"personen, personer, personene","ex":"Jeg ser en person i parken.","ex_tr":"Я вижу человека в парке.","chk":1},{"term":"en kollega","tr":"коллега","pos":"noun","forms":"kollegaen, kollegaer, kollegaene","ex":"Min kollega heter Anne.","ex_tr":"Моя коллега зовут Анна.","chk":1},{"term":"en gjest","tr":"гость","pos":"noun","forms":"","ex":"Velkommen, kjære gjest!","ex_tr":"Добро пожаловать, дорогой гость!"},{"term":"en nabo","tr":"сосед","pos":"noun","forms":"naboen, naboer, naboene","ex":"Min nabo bor i huset ved siden.","ex_tr":"Мой сосед живет в доме рядом.","chk":1},{"term":"en lærer","tr":"учитель","pos":"noun","forms":"læreren, lærere, lærerne","ex":"Læreren sier hei til klassen.","ex_tr":"Учитель говорит привет классу.","chk":1},{"term":"en student","tr":"студент","pos":"noun","forms":"studenten, studenter, studentene","ex":"Studenten spør om veien.","ex_tr":"Студент спрашивает дорогу.","chk":1},{"term":"en samtale","tr":"разговор","pos":"noun","forms":"","ex":"Vi har en kort samtale.","ex_tr":"У нас короткий разговор."},{"term":"en introduksjon","tr":"введение, представление","pos":"noun","forms":"","ex":"Dette er en enkel introduksjon.","ex_tr":"Это простое представление."},{"term":"en adresse","tr":"адрес","pos":"noun","forms":"adressa, adresser, adressene","ex":"Kan du gi meg din adresse?","ex_tr":"Можешь дать мне свой адрес?","chk":1},{"term":"å møte","tr":"встречать, встретиться","pos":"verb","forms":"møter, møtte, har møtt","ex":"Vi skal møte hverandre i morgen.","ex_tr":"Мы встретимся завтра.","chk":1},{"term":"å si","tr":"сказать","pos":"verb","forms":"sier, sa, har sagt","ex":"Kan du si navnet ditt?","ex_tr":"Можешь сказать своё имя?","chk":1},{"term":"å spørre","tr":"спрашивать","pos":"verb","forms":"spør, spurte, har spurt","ex":"Jeg vil spørre om veien.","ex_tr":"Я хочу спросить дорогу.","chk":1},{"term":"å svare","tr":"отвечать","pos":"verb","forms":"svarer, svarte, har svart","ex":"Kan du svare på spørsmålet?","ex_tr":"Можешь ответить на вопрос?","chk":1},{"term":"å beklage","tr":"извиняться, сожалеть","pos":"verb","forms":"","ex":"Jeg vil beklage feilen.","ex_tr":"Я хочу извиниться за ошибку."},{"term":"å kalle","tr":"называть","pos":"verb","forms":"","ex":"Hva vil du kalle barnet?","ex_tr":"Как ты хочешь назвать ребёнка?"},{"term":"snill","tr":"добрый, милый","pos":"adjective","forms":"snilt, snille, snillere, snillest","ex":"Han er en snill person.","ex_tr":"Он добрый человек.","chk":1},{"term":"ei jente","tr":"девушка, девочка","pos":"noun","forms":"jenten, jenter, jentene","ex":"Ei jente smiler.","ex_tr":"Девочка улыбается.","chk":1}]}
