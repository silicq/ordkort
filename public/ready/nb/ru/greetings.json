{"words":[{"term":"hei","tr":"привет","pos":"interjection","forms":"","ex":"Hei, hvordan går det?","ex_tr":"Привет, как дела?","chk":1},{"term":"god morgen","tr":"доброе утро","pos":"phrase","forms":"","ex":"God morgen! Har du sovet godt?","ex_tr":"Доброе утро! Хорошо спал?"},{"term":"god dag","tr":"добрый день","pos":"phrase","forms":"","ex":"God dag, jeg har time klokka ti.","ex_tr":"Добрый день, я записан на десять."},{"term":"god kveld","tr":"добрый вечер","pos":"phrase","forms":"","ex":"God kveld og velkommen!","ex_tr":"Добрый вечер и добро пожаловать!"},{"term":"god natt","tr":"спокойной ночи","pos":"phrase","forms":"","ex":"God natt, sov godt!","ex_tr":"Спокойной ночи, спи сладко!"},{"term":"ha det","tr":"пока","pos":"phrase","forms":"","ex":"Ha det, vi ses i morgen!","ex_tr":"Пока, до завтра!"},{"term":"takk","tr":"спасибо","pos":"noun","forms":"takka, takker, takkene","ex":"Tusen takk for hjelpen!","ex_tr":"Большое спасибо за помощь!","chk":1},{"term":"vær så snill","tr":"пожалуйста","pos":"phrase","forms":"","ex":"Kan du lukke døra, vær så snill?","ex_tr":"Закрой, пожалуйста, дверь."},{"term":"unnskyld","tr":"извините","pos":"interjection","forms":"","ex":"Unnskyld, hvor er toalettet?","ex_tr":"Извините, где туалет?","chk":1},{"term":"beklager","tr":"сожалею, простите","pos":"phrase","forms":"","ex":"Beklager, jeg kom for sent.","ex_tr":"Простите, я опоздал."},{"term":"velkommen","tr":"добро пожаловать","pos":"adjective","forms":"velkomment, velkomne","ex":"Velkommen til Norge!","ex_tr":"Добро пожаловать в Норвегию!","chk":1},{"term":"hyggelig","tr":"приятный","pos":"adjective","forms":"hyggelig, hyggelige, hyggeligere, hyggeligst","ex":"Hyggelig å hilse på deg!","ex_tr":"Приятно познакомиться!","chk":1},{"term":"å hilse","tr":"здороваться","pos":"verb","forms":"hilser, hilste, har hilst","ex":"Hils på bestemor!","ex_tr":"Поздоровайся с бабушкой!","chk":1},{"term":"en hilsen","tr":"привет, приветствие","pos":"noun","forms":"hilsenen, hilsener, hilsenene","ex":"Med vennlig hilsen, Anna.","ex_tr":"С уважением, Анна.","chk":1},{"term":"å hete","tr":"называться, зваться","pos":"verb","forms":"heter, het, har hett","ex":"Jeg heter Oleksandr.","ex_tr":"Меня зовут Александр.","chk":1},{"term":"å presentere","tr":"представлять","pos":"verb","forms":"presenterer, presenterte, har presentert","ex":"Kan jeg presentere kona mi?","ex_tr":"Позвольте представить мою жену.","chk":1},{"term":"høflig","tr":"вежливый","pos":"adjective","forms":"høflig, høflige, høfligere, høfligst","ex":"Det er høflig å si takk.","ex_tr":"Говорить «спасибо» вежливо.","chk":1},{"term":"bare hyggelig","tr":"не за что","pos":"phrase","forms":"","ex":"Takk! – Bare hyggelig!","ex_tr":"Спасибо! — Не за что!"},{"term":"vi ses","tr":"увидимся","pos":"phrase","forms":"","ex":"Vi ses på mandag!","ex_tr":"Увидимся в понедельник!"},{"term":"takk for sist","tr":"спасибо за прошлую встречу","pos":"phrase","forms":"","ex":"Hei, takk for sist! Det var en fin kveld.","ex_tr":"Привет, спасибо за прошлый раз! Хороший был вечер."},{"term":"et håndtrykk","tr":"рукопожатие","pos":"noun","forms":"håndtrykket, håndtrykk, håndtrykkene","ex":"Han hilste med et fast håndtrykk.","ex_tr":"Он поздоровался крепким рукопожатием.","chk":1}]}
