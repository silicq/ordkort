{"words":[{"term":"det går bra","tr":"всё хорошо","pos":"phrase","forms":"","ex":"Hvordan går det? – Det går bra!","ex_tr":"Как дела? — Всё хорошо!"},{"term":"ingen fare","tr":"ничего страшного","pos":"phrase","forms":"","ex":"Beklager! – Ingen fare.","ex_tr":"Извини! — Ничего страшного."},{"term":"ta det med ro","tr":"не волнуйся","pos":"phrase","forms":"","ex":"Ta det med ro, vi rekker det.","ex_tr":"Спокойно, мы успеем."},{"term":"det spiller ingen rolle","tr":"это неважно","pos":"phrase","forms":"","ex":"Kaffe eller te? – Det spiller ingen rolle.","ex_tr":"Кофе или чай? — Неважно."},{"term":"det kommer an på","tr":"смотря как","pos":"phrase","forms":"","ex":"Kommer du? – Det kommer an på været.","ex_tr":"Придёшь? — Зависит от погоды."},{"term":"så klart","tr":"конечно","pos":"phrase","forms":"","ex":"Kan du hjelpe meg? – Så klart!","ex_tr":"Поможешь? — Конечно!"},{"term":"kos deg","tr":"наслаждайся","pos":"phrase","forms":"","ex":"Kos deg på ferien!","ex_tr":"Хорошего отдыха!"},{"term":"lykke til","tr":"удачи","pos":"phrase","forms":"","ex":"Lykke til på prøven!","ex_tr":"Удачи на экзамене!"},{"term":"god bedring","tr":"выздоравливай","pos":"phrase","forms":"","ex":"God bedring, håper du blir frisk snart!","ex_tr":"Выздоравливай поскорее!"},{"term":"gratulerer med dagen","tr":"с днём рождения","pos":"phrase","forms":"","ex":"Gratulerer med dagen, Kari!","ex_tr":"С днём рождения, Кари!"},{"term":"det er synd","tr":"жаль","pos":"phrase","forms":"","ex":"Det er synd at du ikke kan komme.","ex_tr":"Жаль, что ты не сможешь прийти."},{"term":"i orden","tr":"в порядке","pos":"phrase","forms":"","ex":"Alt er i orden.","ex_tr":"Всё в порядке."},{"term":"helt greit","tr":"вполне нормально","pos":"phrase","forms":"","ex":"Kan vi møtes i morgen? – Helt greit.","ex_tr":"Встретимся завтра? — Без проблем."},{"term":"det ordner seg","tr":"всё образуется","pos":"phrase","forms":"","ex":"Ikke vær redd, det ordner seg.","ex_tr":"Не бойся, всё образуется."},{"term":"hva er i veien?","tr":"что случилось?","pos":"phrase","forms":"","ex":"Du ser trist ut. Hva er i veien?","ex_tr":"Ты грустный. Что случилось?"},{"term":"jeg er enig","tr":"я согласен","pos":"phrase","forms":"","ex":"Jeg er helt enig med deg.","ex_tr":"Я полностью с тобой согласен."},{"term":"på tide","tr":"пора","pos":"phrase","forms":"","ex":"Det er på tide å gå hjem.","ex_tr":"Пора идти домой."},{"term":"etter hvert","tr":"постепенно","pos":"phrase","forms":"","ex":"Du lærer det etter hvert.","ex_tr":"Со временем научишься."},{"term":"skål","tr":"за здоровье, ура","pos":"interjection","forms":"","ex":"Skål for brudeparet!","ex_tr":"За молодых!","chk":1},{"term":"velbekomme","tr":"на здоровье","pos":"phrase","forms":"","ex":"Takk for maten! – Velbekomme!","ex_tr":"Спасибо за еду! — На здоровье!"},{"term":"det var en gang","tr":"жил-был","pos":"phrase","forms":"","ex":"Det var en gang en konge.","ex_tr":"Жил-был король."},{"term":"bedre sent enn aldri","tr":"лучше поздно, чем никогда","pos":"phrase","forms":"","ex":"Du kom! Bedre sent enn aldri.","ex_tr":"Ты пришёл! Лучше поздно, чем никогда."}]}
