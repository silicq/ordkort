{"words":[{"term":"hva","tr":"что","pos":"pronoun","forms":"","ex":"Hva er det?","ex_tr":"Что это?","chk":1},{"term":"hvem","tr":"кто","pos":"pronoun","forms":"","ex":"Hvem er hun?","ex_tr":"Кто она?","chk":1},{"term":"hvor","tr":"где","pos":"adverb","forms":"","ex":"Hvor er stasjonen?","ex_tr":"Где вокзал?","chk":1},{"term":"når","tr":"когда","pos":"conjunction","forms":"","ex":"Når åpner butikken?","ex_tr":"Когда открывается магазин?","chk":1},{"term":"hvorfor","tr":"почему","pos":"adverb","forms":"","ex":"Hvorfor er du trist?","ex_tr":"Почему ты грустишь?","chk":1},{"term":"hvordan","tr":"как","pos":"adverb","forms":"","ex":"Hvordan har du det?","ex_tr":"Как дела?","chk":1},{"term":"hvilken","tr":"какой","pos":"determiner","forms":"","ex":"Hvilken buss tar du?","ex_tr":"На каком автобусе ты едешь?","chk":1},{"term":"hvor mye","tr":"сколько","pos":"phrase","forms":"","ex":"Hvor mye koster det?","ex_tr":"Сколько это стоит?"},{"term":"hvor mange","tr":"сколько (штук)","pos":"phrase","forms":"","ex":"Hvor mange barn har du?","ex_tr":"Сколько у тебя детей?"},{"term":"hva slags","tr":"какого рода","pos":"phrase","forms":"","ex":"Hva slags jobb har du?","ex_tr":"Кем ты работаешь?"},{"term":"og","tr":"и","pos":"conjunction","forms":"","ex":"Hun spiser og drikker.","ex_tr":"Она ест и пьёт.","chk":1},{"term":"men","tr":"но","pos":"conjunction","forms":"","ex":"Det er dyrt, men godt.","ex_tr":"Дорого, но вкусно.","chk":1},{"term":"eller","tr":"или","pos":"conjunction","forms":"","ex":"Te eller kaffe?","ex_tr":"Чай или кофе?","chk":1},{"term":"fordi","tr":"потому что","pos":"conjunction","forms":"","ex":"Jeg er hjemme fordi jeg er syk.","ex_tr":"Я дома, потому что болею.","chk":1},{"term":"hvis","tr":"если","pos":"conjunction","forms":"","ex":"Ring meg hvis du kommer.","ex_tr":"Позвони, если придёшь.","chk":1},{"term":"at","tr":"что","pos":"conjunction","forms":"","ex":"Jeg vet at du har rett.","ex_tr":"Я знаю, что ты прав.","chk":1},{"term":"så","tr":"так что, потом","pos":"adverb","forms":"","ex":"Det regnet, så vi ble hjemme.","ex_tr":"Шёл дождь, так что мы остались дома.","chk":1},{"term":"derfor","tr":"поэтому","pos":"adverb","forms":"","ex":"Jeg var trøtt, derfor la jeg meg tidlig.","ex_tr":"Я устал, поэтому рано лёг.","chk":1},{"term":"mens","tr":"пока","pos":"conjunction","forms":"","ex":"Hun leste mens han lagde mat.","ex_tr":"Она читала, пока он готовил.","chk":1},{"term":"selv om","tr":"хотя","pos":"phrase","forms":"","ex":"Vi gikk ut, selv om det var kaldt.","ex_tr":"Мы вышли, хотя было холодно."},{"term":"etter at","tr":"после того как","pos":"phrase","forms":"","ex":"Etter at vi spiste, gikk vi en tur.","ex_tr":"Поев, мы пошли гулять."},{"term":"hvor lenge","tr":"как долго","pos":"phrase","forms":"","ex":"Hvor lenge skal du bli?","ex_tr":"Как долго ты останешься?"},{"term":"hvor ofte","tr":"как часто","pos":"phrase","forms":"","ex":"Hvor ofte trener du?","ex_tr":"Как часто ты тренируешься?"},{"term":"da","tr":"тогда,когда","pos":"adverb","forms":"","ex":"Da kom han hjem.","ex_tr":"Когда он пришёл домой.","chk":1},{"term":"siden","tr":"поскольку,с тех пор как","pos":"conjunction","forms":"","ex":"Siden du kom, har jeg vært glad.","ex_tr":"С тех пор как ты пришёл, я был рад.","chk":1},{"term":"hvilket","tr":"какое (ср.)","pos":"pronoun","forms":"","ex":"Hvilket hus er stort?","ex_tr":"Какой дом большой?"},{"term":"hvilke","tr":"какие (мн.)","pos":"pronoun","forms":"","ex":"Hvilke biler er nye?","ex_tr":"Какие машины новые?"},{"term":"hva med","tr":"а как насчёт","pos":"phrase","forms":"","ex":"Hva med kaffe?","ex_tr":"А как насчёт кофе?"},{"term":"likevel","tr":"тем не менее","pos":"adverb","forms":"","ex":"Han er trøtt, likevel jobber han.","ex_tr":"Он устал, тем не менее работает.","chk":1},{"term":"enten ... eller","tr":"либо ... либо","pos":"phrase","forms":"","ex":"Enten du kommer, eller du blir hjemme.","ex_tr":"Либо ты придёшь, либо останешься дома."},{"term":"hva om","tr":"а если","pos":"phrase","forms":"","ex":"Hva om vi går på kino?","ex_tr":"А если мы пойдем в кино?"},{"term":"i så fall","tr":"в таком случае","pos":"phrase","forms":"","ex":"Kom du for sent, i så fall må du vente.","ex_tr":"Если ты пришёл поздно, в таком случае тебе придётся ждать."},{"term":"dermed","tr":"тем самым","pos":"conjunction","forms":"","ex":"Han skrev brevet, dermed fikk hun svar.","ex_tr":"Он написал письмо, тем самым она получила ответ."},{"term":"både ... og","tr":"и ... и","pos":"phrase","forms":"","ex":"Jeg liker både kaffe og te.","ex_tr":"Мне нравятся и кофе, и чай."},{"term":"altså","tr":"значит","pos":"adverb","forms":"","ex":"Han er forsinket, altså må vi starte uten ham.","ex_tr":"Он опоздал, значит, мы начнём без него.","chk":1},{"term":"et spørsmål","tr":"вопрос","pos":"noun","forms":"spørsmålet, spørsmål, spørsmålene","ex":"Jeg har et viktig spørsmål.","ex_tr":"У меня важный вопрос.","chk":1},{"term":"et svar","tr":"ответ","pos":"noun","forms":"svaret, svar, svarene","ex":"Kan du gi meg et kort svar?","ex_tr":"Можешь дать мне короткий ответ?","chk":1},{"term":"en årsak","tr":"причина","pos":"noun","forms":"","ex":"Dette er hovedårsaken til problemet.","ex_tr":"Это главная причина проблемы."},{"term":"å spørre","tr":"спрашивать, задать вопрос","pos":"verb","forms":"spør, spurte, har spurt","ex":"Jeg liker å spørre når jeg er usikker.","ex_tr":"Мне нравится спрашивать, когда я не уверен.","chk":1},{"term":"å svare","tr":"отвечать","pos":"verb","forms":"svarer, svarte, har svart","ex":"Han klarte å svare på alle spørsmålene.","ex_tr":"Он смог ответить на все вопросы.","chk":1}]}
