{"words":[{"term":"glad","tr":"радостный","pos":"adjective","forms":"glad, glade, gladere, gladest","ex":"Jeg er så glad i dag!","ex_tr":"Я сегодня так рад!","chk":1},{"term":"trist","tr":"грустный","pos":"adjective","forms":"trist, triste, tristere, tristest","ex":"Hvorfor er du trist?","ex_tr":"Почему ты грустишь?","chk":1},{"term":"sint","tr":"сердитый","pos":"adjective","forms":"sint, sinte, sintere, sintest","ex":"Er du sint på meg?","ex_tr":"Ты на меня сердишься?","chk":1},{"term":"redd","tr":"испуганный","pos":"adjective","forms":"redd, redde, reddere, reddest","ex":"Barnet er redd for mørket.","ex_tr":"Ребёнок боится темноты.","chk":1},{"term":"lei seg","tr":"расстроенный","pos":"phrase","forms":"","ex":"Hun ble lei seg.","ex_tr":"Она расстроилась."},{"term":"nervøs","tr":"нервный, взволнованный","pos":"adjective","forms":"nervøst, nervøse, nervøsere, nervøsest","ex":"Jeg er nervøs før prøven.","ex_tr":"Я нервничаю перед экзаменом.","chk":1},{"term":"stolt","tr":"гордый","pos":"adjective","forms":"stolt, stolte, stoltere, stoltest","ex":"Vi er stolte av deg!","ex_tr":"Мы гордимся тобой!","chk":1},{"term":"sliten","tr":"уставший","pos":"adjective","forms":"slitent, slitne","ex":"Jeg er sliten etter jobben.","ex_tr":"Я устал после работы.","chk":1},{"term":"ensom","tr":"одинокий","pos":"adjective","forms":"ensomt, ensomme, ensommere, ensomst","ex":"Mange føler seg ensomme i en ny by.","ex_tr":"Многие чувствуют себя одиноко в новом городе.","chk":1},{"term":"fornøyd","tr":"довольный","pos":"adjective","forms":"fornøyd, fornøyde","ex":"Er du fornøyd med jobben?","ex_tr":"Ты доволен работой?","chk":1},{"term":"snill","tr":"добрый","pos":"adjective","forms":"snilt, snille, snillere, snillest","ex":"Hun er snill mot alle.","ex_tr":"Она добра ко всем.","chk":1},{"term":"morsom","tr":"весёлый, смешной","pos":"adjective","forms":"morsomt, morsomme, morsommere, morsomst","ex":"Han er veldig morsom.","ex_tr":"Он очень весёлый.","chk":1},{"term":"sjenert","tr":"застенчивый","pos":"adjective","forms":"sjenert, sjenerte","ex":"Hun er litt sjenert.","ex_tr":"Она немного стеснительная.","chk":1},{"term":"tålmodig","tr":"терпеливый","pos":"adjective","forms":"tålmodig, tålmodige, tålmodigere, tålmodigst","ex":"Læreren er veldig tålmodig.","ex_tr":"Учитель очень терпелив.","chk":1},{"term":"ærlig","tr":"честный","pos":"adjective","forms":"ærlig, ærlige, ærligere, ærligst","ex":"Vær ærlig med meg.","ex_tr":"Будь со мной честен.","chk":1},{"term":"en følelse","tr":"чувство","pos":"noun","forms":"følelsen, følelser, følelsene","ex":"Det er en rar følelse.","ex_tr":"Странное чувство.","chk":1},{"term":"ei glede","tr":"радость","pos":"noun","forms":"gleden, gleder, gledene","ex":"Barna hoppet av glede.","ex_tr":"Дети прыгали от радости.","chk":1},{"term":"å glede seg","tr":"ждать с радостью","pos":"verb","forms":"","ex":"Jeg gleder meg til ferien.","ex_tr":"Жду не дождусь отпуска."},{"term":"å føle seg","tr":"чувствовать себя","pos":"verb","forms":"","ex":"Jeg føler meg bedre nå.","ex_tr":"Сейчас мне лучше."},{"term":"å savne","tr":"скучать","pos":"verb","forms":"savner, savna, har savna","ex":"Jeg savner hjemlandet mitt.","ex_tr":"Я скучаю по родине.","chk":1},{"term":"å kjede seg","tr":"скучать (от безделья)","pos":"verb","forms":"","ex":"Barna kjeder seg i regnværet.","ex_tr":"Детям скучно в дождь."},{"term":"overrasket","tr":"удивлённый","pos":"adjective","forms":"","ex":"Jeg ble veldig overrasket.","ex_tr":"Я очень удивился."},{"term":"et sinn","tr":"настроение, дух","pos":"noun","forms":"","ex":"Hun har ikke godt humør i dag.","ex_tr":"У неё сегодня плохое настроение."},{"term":"en stemning","tr":"атмосфера, настроение","pos":"noun","forms":"","ex":"Det er en hyggelig stemning på festen.","ex_tr":"На вечеринке приятная атмосфера."},{"term":"en personlighet","tr":"характер, личность","pos":"noun","forms":"","ex":"Han har en morsom personlighet.","ex_tr":"У него интересный характер."},{"term":"en stemme","tr":"голос","pos":"noun","forms":"","ex":"Hun har en vakker stemme.","ex_tr":"У неё красивый голос."},{"term":"et humør","tr":"настроение","pos":"noun","forms":"","ex":"Jeg har dårlig humør i dag.","ex_tr":"Сегодня у меня плохое настроение."},{"term":"en reaksjon","tr":"реакция","pos":"noun","forms":"","ex":"Hans reaksjon var overraskende.","ex_tr":"Его реакция была неожиданной."},{"term":"en holdning","tr":"отношение, позиция","pos":"noun","forms":"","ex":"Hun har en positiv holdning til livet.","ex_tr":"У неё позитивное отношение к жизни."},{"term":"en tanke","tr":"мысль","pos":"noun","forms":"tanken, tanker, tankene","ex":"Jeg har en god tanke.","ex_tr":"У меня есть хорошая мысль.","chk":1},{"term":"en drøm","tr":"мечта, сон","pos":"noun","forms":"","ex":"Min drøm er å reise til Norge.","ex_tr":"Моя мечта — поехать в Норвегию."},{"term":"et minne","tr":"память, воспоминание","pos":"noun","forms":"","ex":"Jeg har et fint minne fra barndommen.","ex_tr":"У меня есть приятное воспоминание из детства."},{"term":"en opplevelse","tr":"переживание, опыт","pos":"noun","forms":"","ex":"Det var en spennende opplevelse.","ex_tr":"Это было волнительное переживание."},{"term":"en sorg","tr":"печаль, скорбь","pos":"noun","forms":"","ex":"Hun opplevde stor sorg etter tapet av faren sin.","ex_tr":"Она испытала большую печаль после потери отца."},{"term":"en engstelse","tr":"тревога, беспокойство","pos":"noun","forms":"","ex":"Jeg føler en stor engstelse før eksamenen.","ex_tr":"Я чувствую большую тревогу перед экзаменом."},{"term":"et håp","tr":"надежда","pos":"noun","forms":"","ex":"Jeg har håp om at det blir bedre.","ex_tr":"Я надеюсь, что станет лучше."},{"term":"en stolthet","tr":"гордость","pos":"noun","forms":"","ex":"Han er full av stolthet over resultatet.","ex_tr":"Он полон гордости за результат."},{"term":"en skam","tr":"стыд, позор","pos":"noun","forms":"","ex":"Jeg føler skam over at jeg løg.","ex_tr":"Я чувствую стыд за то, что солгал."},{"term":"en skuffelse","tr":"разочарование","pos":"noun","forms":"","ex":"Det var en stor skuffelse for meg.","ex_tr":"Это было большим разочарованием для меня."},{"term":"en misunnelse","tr":"зависть","pos":"noun","forms":"","ex":"Jeg føler misunnelse for hans suksess.","ex_tr":"Я чувствую зависть к его успеху."},{"term":"en empati","tr":"эмпатия, сочувствие","pos":"noun","forms":"","ex":"Hun viser mye empati mot sine venner.","ex_tr":"Она проявляет много эмпатии к своим друзьям."},{"term":"en selvtillit","tr":"уверенность в себе","pos":"noun","forms":"","ex":"Han har mye selvtillit i jobben.","ex_tr":"У него много уверенности в себе на работе."},{"term":"en nervøsitet","tr":"нервозность, нервное напряжение","pos":"noun","forms":"","ex":"Jeg føler nervøsitet før intervjuet.","ex_tr":"Я чувствую нервное напряжение перед собеседованием."},{"term":"å grine","tr":"плакать, рыдать","pos":"verb","forms":"","ex":"Hun grinner fordi hun er så trist.","ex_tr":"Она плачет, потому что ей очень грустно."},{"term":"å smile","tr":"улыбаться","pos":"verb","forms":"smiler, smilte, har smilt","ex":"Han smiler alltid når han ser deg.","ex_tr":"Он всегда улыбается, когда видит тебя.","chk":1}]}
