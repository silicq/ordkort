{"words":[{"term":"glad","tr":"радостный","pos":"adjective","forms":"glad, glade, gladere, gladest","ex":"Jeg er så glad i dag!","ex_tr":"Я сегодня так рад!","chk":1},{"term":"trist","tr":"грустный","pos":"adjective","forms":"trist, triste, tristere, tristest","ex":"Hvorfor er du trist?","ex_tr":"Почему ты грустишь?","chk":1},{"term":"sint","tr":"сердитый","pos":"adjective","forms":"sint, sinte, sintere, sintest","ex":"Er du sint på meg?","ex_tr":"Ты на меня сердишься?","chk":1},{"term":"redd","tr":"испуганный","pos":"adjective","forms":"redd, redde, reddere, reddest","ex":"Barnet er redd for mørket.","ex_tr":"Ребёнок боится темноты.","chk":1},{"term":"lei seg","tr":"расстроенный","pos":"phrase","forms":"","ex":"Hun ble lei seg.","ex_tr":"Она расстроилась."},{"term":"nervøs","tr":"нервный, взволнованный","pos":"adjective","forms":"nervøst, nervøse, nervøsere, nervøsest","ex":"Jeg er nervøs før prøven.","ex_tr":"Я нервничаю перед экзаменом.","chk":1},{"term":"stolt","tr":"гордый","pos":"adjective","forms":"stolt, stolte, stoltere, stoltest","ex":"Vi er stolte av deg!","ex_tr":"Мы гордимся тобой!","chk":1},{"term":"sliten","tr":"уставший","pos":"adjective","forms":"slitent, slitne","ex":"Jeg er sliten etter jobben.","ex_tr":"Я устал после работы.","chk":1},{"term":"ensom","tr":"одинокий","pos":"adjective","forms":"ensomt, ensomme, ensommere, ensomst","ex":"Mange føler seg ensomme i en ny by.","ex_tr":"Многие чувствуют себя одиноко в новом городе.","chk":1},{"term":"fornøyd","tr":"довольный","pos":"adjective","forms":"fornøyd, fornøyde","ex":"Er du fornøyd med jobben?","ex_tr":"Ты доволен работой?","chk":1},{"term":"snill","tr":"добрый","pos":"adjective","forms":"snilt, snille, snillere, snillest","ex":"Hun er snill mot alle.","ex_tr":"Она добра ко всем.","chk":1},{"term":"morsom","tr":"весёлый, смешной","pos":"adjective","forms":"morsomt, morsomme, morsommere, morsomst","ex":"Han er veldig morsom.","ex_tr":"Он очень весёлый.","chk":1},{"term":"sjenert","tr":"застенчивый","pos":"adjective","forms":"sjenert, sjenerte","ex":"Hun er litt sjenert.","ex_tr":"Она немного стеснительная.","chk":1},{"term":"tålmodig","tr":"терпеливый","pos":"adjective","forms":"tålmodig, tålmodige, tålmodigere, tålmodigst","ex":"Læreren er veldig tålmodig.","ex_tr":"Учитель очень терпелив.","chk":1},{"term":"ærlig","tr":"честный","pos":"adjective","forms":"ærlig, ærlige, ærligere, ærligst","ex":"Vær ærlig med meg.","ex_tr":"Будь со мной честен.","chk":1},{"term":"en følelse","tr":"чувство","pos":"noun","forms":"følelsen, følelser, følelsene","ex":"Det er en rar følelse.","ex_tr":"Странное чувство.","chk":1},{"term":"ei glede","tr":"радость","pos":"noun","forms":"gleden, gleder, gledene","ex":"Barna hoppet av glede.","ex_tr":"Дети прыгали от радости.","chk":1},{"term":"å glede seg","tr":"ждать с радостью","pos":"verb","forms":"","ex":"Jeg gleder meg til ferien.","ex_tr":"Жду не дождусь отпуска."},{"term":"å føle seg","tr":"чувствовать себя","pos":"verb","forms":"","ex":"Jeg føler meg bedre nå.","ex_tr":"Сейчас мне лучше."},{"term":"å savne","tr":"скучать","pos":"verb","forms":"savner, savnet, har savnet","ex":"Jeg savner hjemlandet mitt.","ex_tr":"Я скучаю по родине.","chk":1},{"term":"å kjede seg","tr":"скучать (от безделья)","pos":"verb","forms":"","ex":"Barna kjeder seg i regnværet.","ex_tr":"Детям скучно в дождь."},{"term":"overrasket","tr":"удивлённый","pos":"adjective","forms":"","ex":"Jeg ble veldig overrasket.","ex_tr":"Я очень удивился."}]}
