{"words":[{"term":"hei","tr":"hi, hello","pos":"interjection","forms":"","ex":"Hei, hvordan går det?","ex_tr":"Hi, how are you?","chk":1},{"term":"god morgen","tr":"good morning","pos":"phrase","forms":"","ex":"God morgen! Har du sovet godt?","ex_tr":"Good morning! Did you sleep well?"},{"term":"god dag","tr":"good day, hello","pos":"phrase","forms":"","ex":"God dag, jeg har time klokka ti.","ex_tr":"Good day, I have an appointment at ten."},{"term":"god kveld","tr":"good evening","pos":"phrase","forms":"","ex":"God kveld og velkommen!","ex_tr":"Good evening and welcome!"},{"term":"god natt","tr":"good night","pos":"phrase","forms":"","ex":"God natt, sov godt!","ex_tr":"Good night, sleep well!"},{"term":"ha det","tr":"bye","pos":"phrase","forms":"","ex":"Ha det, vi ses i morgen!","ex_tr":"Bye, see you tomorrow!"},{"term":"takk","tr":"thanks","pos":"noun","forms":"takka, takker, takkene","ex":"Tusen takk for hjelpen!","ex_tr":"Thanks a lot for the help!","chk":1},{"term":"vær så snill","tr":"please","pos":"phrase","forms":"","ex":"Kan du lukke døra, vær så snill?","ex_tr":"Can you close the door, please?"},{"term":"unnskyld","tr":"excuse me, sorry","pos":"interjection","forms":"","ex":"Unnskyld, hvor er toalettet?","ex_tr":"Excuse me, where is the toilet?","chk":1},{"term":"beklager","tr":"I’m sorry","pos":"phrase","forms":"","ex":"Beklager, jeg kom for sent.","ex_tr":"Sorry, I was late."},{"term":"velkommen","tr":"welcome","pos":"adjective","forms":"velkomment, velkomne","ex":"Velkommen til Norge!","ex_tr":"Welcome to Norway!","chk":1},{"term":"hyggelig","tr":"nice, pleasant","pos":"adjective","forms":"hyggelig, hyggelige, hyggeligere, hyggeligst","ex":"Hyggelig å hilse på deg!","ex_tr":"Nice to meet you!","chk":1},{"term":"å hilse","tr":"to greet, to say hello","pos":"verb","forms":"hilser, hilste, har hilst","ex":"Hils på bestemor!","ex_tr":"Say hello to Grandma!","chk":1},{"term":"en hilsen","tr":"greeting, regards","pos":"noun","forms":"hilsenen, hilsener, hilse