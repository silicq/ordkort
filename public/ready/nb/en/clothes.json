{"words":[{"term":"klær","tr":"clothes","pos":"noun","forms":"klærne","ex":"Ta på deg varme klær.","ex_tr":"Put on warm clothes.","chk":1},{"term":"ei jakke","tr":"jacket","pos":"noun","forms":"jakka, jakker, jakkene","ex":"Jakka henger i gangen.","ex_tr":"The jacket hangs in the hall.","chk":1},{"term":"ei bukse","tr":"trousers","pos":"noun","forms":"buksa, bukser, buksene","ex":"Buksa er for stor.","ex_tr":"The trousers are too big.","chk":1},{"term":"en genser","tr":"sweater, jumper","pos":"noun","forms":"genseren, gensere, genserne","ex":"Bestemor strikket en genser til meg.","ex_tr":"Grandma knitted me a sweater.","chk":1},{"term":"ei skjorte","tr":"shirt","pos":"noun","forms":"skjorta, skjorter, skjortene","ex":"Han har på seg en hvit skjorte.","ex_tr":"He is wearing a white shirt.","chk":1},{"term":"en kjole","tr":"dress","pos":"noun","forms":"kjolen, kjoler, kjolene","ex":"Hun kjøpte en ny kjole.","ex_tr":"She bought a new dress.","chk":1},{"term":"et skjørt","tr":"skirt","pos":"noun","forms":"skjørtet, skjørt, skjørtene","ex":"Skjørtet er for kort.","ex_tr":"The skirt is too short.","chk":1},{"term":"en sko","tr":"shoe","pos":"noun","forms":"skoen, sko, skoene","ex":"Ta av deg skoene, er du snill.","ex_tr":"Please take off your shoes.","chk":1},{"term":"en støvel","tr":"boot","pos":"noun","forms":"støvelen, støvler, støvlene","ex":"Barna trenger gode støvler.","ex_tr":"The children need good boots.","chk":1},{"term":"ei lue","tr":"hat, beanie","pos":"noun","forms":"lua, luer, luene","ex":"Husk lua, det er kaldt!","ex_tr":"Remember your hat, it’s cold!","chk":1},{"term":"et skjerf","tr":"scarf","pos":"noun","forms":"skjerfet, skjerf, skjerfene","ex":"Hun har et varmt skjerf.","ex_tr":"She has a warm scarf.","chk":1},{"term":"en vott","tr":"mitten","pos":"noun","forms":"votten, votter, vottene","ex":"Barnet mistet en vott.","ex_tr":"The child lost a mitten.","chk":1},{"term":"en sokk","tr":"sock","pos":"noun","forms":"sokken, sokker, sokkene","ex":"Jeg trenger nye sokker.","ex_tr":"I need new socks.","chk":1},{"term":"en regnjakke","tr":"rain jacket","pos":"noun","forms":"regnjakken, regnjakker, regnjakkene","ex":"I Bergen trenger du regnjakke.","ex_tr":"In Bergen you need a rain jacket.","chk":1},{"term":"ull","tr":"wool","pos":"noun","forms":"ulla, uller, ullene","ex":"Ull holder deg varm.","ex_tr":"Wool keeps you warm.","chk":1},{"term":"en størrelse","tr":"size","pos":"noun","forms":"størrelsen, størrelser, størrelsene","ex":"Har du denne i en større størrelse?","ex_tr":"Do you have this in a bigger size?","chk":1},{"term":"å ta på seg","tr":"to put on","pos":"phrase","forms":"","ex":"Ta på deg jakka!","ex_tr":"Put your jacket on!"},{"term":"å ta av seg","tr":"to take off","pos":"phrase","forms":"","ex":"Han tok av seg lua.","ex_tr":"He took off his hat."},{"term":"å prøve","tr":"to try on","pos":"verb","forms":"prøver, prøvde, har prøvd","ex":"Kan jeg prøve denne?","ex_tr":"Can I try this on?","chk":1},{"term":"en dress","tr":"suit","pos":"noun","forms":"dressen, dresser, dressene","ex":"Han hadde på seg dress i bryllupet.","ex_tr":"He wore a suit at the wedding.","chk":1},{"term":"en bunad","tr":"national costume","pos":"noun","forms":"bunaden, bunader, bunadene","ex":"Mange går i bunad på 17. mai.","ex_tr":"Many wear national costume on 17 May.","chk":1}]}
