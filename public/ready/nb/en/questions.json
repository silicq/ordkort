{"words":[{"term":"hva","tr":"what","pos":"pronoun","forms":"","ex":"Hva er det?","ex_tr":"What is it?","chk":1},{"term":"hvem","tr":"who","pos":"pronoun","forms":"","ex":"Hvem er hun?","ex_tr":"Who is she?","chk":1},{"term":"hvor","tr":"where","pos":"adverb","forms":"","ex":"Hvor er stasjonen?","ex_tr":"Where is the station?","chk":1},{"term":"når","tr":"when","pos":"conjunction","forms":"","ex":"Når åpner butikken?","ex_tr":"When does the shop open?","chk":1},{"term":"hvorfor","tr":"why","pos":"adverb","forms":"","ex":"Hvorfor er du trist?","ex_tr":"Why are you sad?","chk":1},{"term":"hvordan","tr":"how","pos":"adverb","forms":"","ex":"Hvordan har du det?","ex_tr":"How are you?","chk":1},{"term":"hvilken","tr":"which","pos":"determiner","forms":"","ex":"Hvilken buss tar du?","ex_tr":"Which bus do you take?","chk":1},{"term":"hvor mye","tr":"how much","pos":"phrase","forms":"","ex":"Hvor mye koster det?","ex_tr":"How much does it cost?"},{"term":"hvor mange","tr":"how many","pos":"phrase","forms":"","ex":"Hvor mange barn har du?","ex_tr":"How many children do you have?"},{"term":"hva slags","tr":"what kind of","pos":"phrase","forms":"","ex":"Hva slags jobb har du?","ex_tr":"What kind of job do you have?"},{"term":"og","tr":"and","pos":"conjunction","forms":"","ex":"Hun spiser og drikker.","ex_tr":"She eats and drinks.","chk":1},{"term":"men","tr":"but","pos":"conjunction","forms":"","ex":"Det er dyrt, men godt.","ex_tr":"It is expensive but good.","chk":1},{"term":"eller","tr":"or","pos":"conjunction","forms":"","ex":"Te eller kaffe?","ex_tr":"Tea or coffee?","chk":1},{"term":"fordi","tr":"because","pos":"conjunction","forms":"","ex":"Jeg er hjemme fordi jeg er syk.","ex_tr":"I am at home because I am ill.","chk":1},{"term":"hvis","tr":"if","pos":"conjunction","forms":"","ex":"Ring meg hvis du kommer.","ex_tr":"Call me if you are coming.","chk":1},{"term":"at","tr":"that","pos":"conjunction","forms":"","ex":"Jeg vet at du har rett.","ex_tr":"I know that you are right.","chk":1},{"term":"så","tr":"so, then","pos":"adverb","forms":"","ex":"Det regnet, så vi ble hjemme.","ex_tr":"It rained, so we stayed home.","chk":1},{"term":"derfor","tr":"therefore","pos":"adverb","forms":"","ex":"Jeg var trøtt, derfor la jeg meg tidlig.","ex_tr":"I was tired, so I went to bed early.","chk":1},{"term":"mens","tr":"while","pos":"conjunction","forms":"","ex":"Hun leste mens han lagde mat.","ex_tr":"She read while he cooked.","chk":1},{"term":"selv om","tr":"even though","pos":"phrase","forms":"","ex":"Vi gikk ut, selv om det var kaldt.","ex_tr":"We went out even though it was cold."},{"term":"etter at","tr":"after (+ clause)","pos":"phrase","forms":"","ex":"Etter at vi spiste, gikk vi en tur.","ex_tr":"After we ate, we went for a walk."}]}
