{"words":[{"term":"det går bra","tr":"الأمور بخير، تمام","pos":"phrase","forms":"","ex":"Hvordan går det? – Det går bra!","ex_tr":"كيف حالك؟ – بخير!"},{"term":"ingen fare","tr":"لا مشكلة، لا تقلق","pos":"phrase","forms":"","ex":"Beklager! – Ingen fare.","ex_tr":"آسف! – لا مشكلة."},{"term":"ta det med ro","tr":"على مهلك، خذ راحتك","pos":"phrase","forms":"","ex":"Ta det med ro, vi rekker det.","ex_tr":"على مهلك، سنلحق."},{"term":"det spiller ingen rolle","tr":"لا يهمّ، سيّان","pos":"phrase","forms":"","ex":"Kaffe eller te? – Det spiller ingen rolle.","ex_tr":"قهوة أم شاي؟ – لا فرق."},{"term":"det kommer an på","tr":"حسب، يتوقّف على","pos":"phrase","forms":"","ex":"Kommer du? – Det kommer an på været.","ex_tr":"هل ستأتي؟ – يتوقّف ذلك على الطقس."},{"term":"så klart","tr":"طبعًا، بالتأكيد","pos":"phrase","forms":"","ex":"Kan du hjelpe meg? – Så klart!","ex_tr":"هل تساعدني؟ – طبعًا!"},{"term":"kos deg","tr":"استمتع، انبسط","pos":"phrase","forms":"","ex":"Kos deg på ferien!","ex_tr":"استمتع بعطلتك!"},{"term":"lykke til","tr":"حظًا موفّقًا","pos":"phrase","forms":"","ex":"Lykke til på prøven!","ex_tr":"حظًا موفّقًا في الاختبار!"},{"term":"god bedring","tr":"سلامتك، شفاك الله","pos":"phrase","forms":"","ex":"God bedring, håper du blir frisk snart!","ex_tr":"سلامتك، أتمنى أن تتعافى قريبًا!"},{"term":"gratulerer med dagen","tr":"عيد ميلاد سعيد، كل عام وأنت بخير","pos":"phrase","forms":"","ex":"Gratulerer med dagen, Kari!","ex_tr":"عيد ميلاد سعيد يا كاري!"},{"term":"det er synd","tr":"يا للأسف، خسارة","pos":"phrase","forms":"","ex":"Det er synd at du ikke kan komme.","ex_tr":"خسارة أنك لا تستطيع المجيء."},{"term":"i orden","tr":"على ما يرام، تمام","pos":"phrase","forms":"","ex":"Alt er i orden.","ex_tr":"كل شيء على ما يرام."},{"term":"helt greit","tr":"لا بأس أبدًا","pos":"phrase","forms":"","ex":"Kan vi møtes i morgen? – Helt greit.","ex_tr":"هل نلتقي غدًا؟ – لا بأس أبدًا."},{"term":"det ordner seg","tr":"ستُحلّ، ستتدبّر الأمور","pos":"phrase","forms":"","ex":"Ikke vær redd, det ordner seg.","ex_tr":"لا تخف، ستُحلّ الأمور."},{"term":"hva er i veien?","tr":"ما الخطب؟ ما بك؟","pos":"phrase","forms":"","ex":"Du ser trist ut. Hva er i veien?","ex_tr":"تبدو حزينًا. ما بك؟"},{"term":"jeg er enig","tr":"أنا موافق","pos":"phrase","forms":"","ex":"Jeg er helt enig med deg.","ex_tr":"أنا موافق معك تمامًا."},{"term":"på tide","tr":"حان الوقت","pos":"phrase","forms":"","ex":"Det er på tide å gå hjem.","ex_tr":"حان وقت العودة إلى البيت."},{"term":"etter hvert","tr":"مع الوقت، تدريجيًا","pos":"phrase","forms":"","ex":"Du lærer det etter hvert.","ex_tr":"ستتعلّمه مع الوقت."},{"term":"skål","tr":"في صحتك، نخب","pos":"interjection","forms":"","ex":"Skål for brudeparet!","ex_tr":"نخب العروسين!","chk":1},{"term":"velbekomme","tr":"بالهناء والشفاء (ردًّا على الشكر)","pos":"phrase","forms":"","ex":"Takk for maten! – Velbekomme!","ex_tr":"شكرًا على الطعام! – بالهناء والشفاء!"},{"term":"det var en gang","tr":"كان يا ما كان","pos":"phrase","forms":"","ex":"Det var en gang en konge.","ex_tr":"كان يا ما كان، كان هناك ملك."},{"term":"bedre sent enn aldri","tr":"أن تأتي متأخرًا خير من ألا تأتي","pos":"phrase","forms":"","ex":"Du kom! Bedre sent enn aldri.","ex_tr":"جئت! أن تأتي متأخرًا خير من ألا تأتي."}]}
